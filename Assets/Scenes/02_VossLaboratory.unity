MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1195760647}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a56ce10e655e4ad09904e2a3f328aaf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Voss.Narrative.VideoInvestigationController
  vossFigure: {fileID: 2018261787}
  projectionQuad: {fileID: 1266547961}
  stageLights:
  - {fileID: 901879497}
  - {fileID: 1482741852}
  - {fileID: 591036156}
  cameraA: {fileID: 1723010615}
  cameraB: {fileID: 1216653575}
  screenA: {fileID: 713947198}
  screenB: {fileID: 1973403514}
  captionA: {fileID: 506104690}
  captionB: {fileID: 237500041}
  secondsPerFrame: 1.1
  holdSeconds: 3
  frames:
  - vossLocalPosition: {x: -3, y: 0, z: 0.5}
    vossVisible: 1
    projectionAlpha: 0
    stageLit: 1
    captionA: 00  Voss walks on stage.
    captionB: 00  Voss walks on stage.
  - vossLocalPosition: {x: -2, y: 0, z: 0.5}
    vossVisible: 1
    projectionAlpha: 0
    stageLit: 1
    captionA: 01  He approaches the glass chamber.
    captionB: 01  He approaches the glass chamber.
  - vossLocalPosition: {x: -1.2, y: 0, z: 0.5}
    vossVisible: 1
    projectionAlpha: 0
    stageLit: 1
    captionA: 02  He stops beside the chamber.
    captionB: 02  He stops beside the chamber.
  - vossLocalPosition: {x: -0.7, y: 0, z: 0.2}
    vossVisible: 1
    projectionAlpha: 0.35
    stageLit: 1
    captionA: 03  He steps toward the door.
    captionB: 03  A faint shape appears inside the glass. Voss is still outside.
  - vossLocalPosition: {x: -0.7, y: 0, z: -0.6}
    vossVisible: 1
    projectionAlpha: 0.8
    stageLit: 1
    captionA: 04  Voss enters the chamber.
    captionB: 04  Voss moves sideways, behind the light. The shape inside is not him.
  - vossLocalPosition: {x: -0.9, y: 0, z: -1.6}
    vossVisible: 1
    projectionAlpha: 1
    stageLit: 1
    captionA: 05  The chamber locks.
    captionB: 05  Voss is in darkness beside the chamber. The chamber locks on a silhouette.
  - vossLocalPosition: {x: -1.4, y: 0, z: -2.6}
    vossVisible: 1
    projectionAlpha: 1
    stageLit: 1
    captionA: 06  His hand touches the glass. 'Seven seconds.'
    captionB: 06  The projected hand touches the glass. Voss is already gone.
  - vossLocalPosition: {x: -2.2, y: 0, z: -3.4}
    vossVisible: 0
    projectionAlpha: 0
    stageLit: 0
    captionA: 07  Blackout.
    captionB: 07  Blackout. Nothing left to hide.
  - vossLocalPosition: {x: -2.2, y: 0, z: -3.4}
    vossVisible: 0
    projectionAlpha: 0
    stageLit: 0
    captionA: 08  Seven seconds pass.
    captionB: 08  Seven seconds pass. The projector is switched off.
  - vossLocalPosition: {x: -2.2, y: 0, z: -3.4}
    vossVisible: 0
    projectionAlpha: 0
    stageLit: 1
    captionA: 09  Lights. The chamber is empty.
    captionB: 09  Lights. The chamber was always empty.
